{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-studio.local/schemas/job_event.v1.json",
  "title": "JobEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "aggregate_id", "occurred_at", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "pattern": "^[a-z]+(\\.[a-z]+)+\\.v[0-9]+$"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}

