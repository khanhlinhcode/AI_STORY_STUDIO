{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-studio.local/schemas/episode_spec.v1.json",
  "title": "EpisodeSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "lesson", "characters", "scenes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "lesson": {"type": "string", "minLength": 1, "maxLength": 500},
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {"$ref": "scene_spec.v1.json"}
    }
  }
}

