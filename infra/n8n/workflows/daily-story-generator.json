{
  "name": "AI Story Studio - Daily Story Generator",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "daily-schedule",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }] } }
    },
    {
      "id": "daily-sheets",
      "name": "Read Google Sheets topics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $env.TOPICS_SHEET_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "={{ $env.TOPICS_SHEET_NAME }}", "mode": "name" },
        "options": {}
      }
    },
    {
      "id": "daily-topics",
      "name": "Select unprocessed topics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": { "jsCode": "const topics = items.filter(item => String(item.json.status || '').toLowerCase() !== 'done').map(item => String(item.json.topic || '').trim()).filter(Boolean); if (!topics.length) return []; return [{ json: { topics: topics.slice(0, 50) } }];" }
    },
    {
      "id": "daily-batch",
      "name": "Create batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300],
      "parameters": {
        "method": "POST",
        "url": "http://studio-api:8000/webhooks/batch",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $env.STUDIO_INTERNAL_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project_id: $env.STUDIO_PROJECT_ID, topics: $json.topics }) }}",
        "options": {}
      }
    },
    {
      "id": "daily-wait",
      "name": "Wait 5 minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 300],
      "webhookId": "ai-story-studio-daily-wait",
      "parameters": { "resume": "timeInterval", "amount": 5, "unit": "minutes" }
    },
    {
      "id": "daily-status",
      "name": "Poll batch status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://studio-api:8000/webhooks/batches/' + $json.batch_id + '/status' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $env.STUDIO_INTERNAL_KEY }}" }] },
        "options": {}
      }
    },
    {
      "id": "daily-terminal",
      "name": "Batch finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1680, 300],
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "or", "conditions": [
          { "id": "daily-completed", "leftValue": "={{ $json.status }}", "rightValue": "completed", "operator": { "type": "string", "operation": "equals" } },
          { "id": "daily-failed", "leftValue": "={{ $json.status }}", "rightValue": "failed", "operator": { "type": "string", "operation": "equals" } },
          { "id": "daily-cancelled", "leftValue": "={{ $json.status }}", "rightValue": "cancelled", "operator": { "type": "string", "operation": "equals" } }
        ] },
        "options": {}
      }
    },
    {
      "id": "daily-telegram",
      "name": "Telegram batch result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 240],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: 'AI Story Studio batch ' + $json.batch_id + ': ' + $json.status + '. Hoàn tất ' + $json.completed + ' video, lỗi ' + $json.failed + '.' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily 07:00": { "main": [[{ "node": "Read Google Sheets topics", "type": "main", "index": 0 }]] },
    "Read Google Sheets topics": { "main": [[{ "node": "Select unprocessed topics", "type": "main", "index": 0 }]] },
    "Select unprocessed topics": { "main": [[{ "node": "Create batch", "type": "main", "index": 0 }]] },
    "Create batch": { "main": [[{ "node": "Wait 5 minutes", "type": "main", "index": 0 }]] },
    "Wait 5 minutes": { "main": [[{ "node": "Poll batch status", "type": "main", "index": 0 }]] },
    "Poll batch status": { "main": [[{ "node": "Batch finished?", "type": "main", "index": 0 }]] },
    "Batch finished?": { "main": [[{ "node": "Telegram batch result", "type": "main", "index": 0 }], [{ "node": "Wait 5 minutes", "type": "main", "index": 0 }]] }
  }
}
